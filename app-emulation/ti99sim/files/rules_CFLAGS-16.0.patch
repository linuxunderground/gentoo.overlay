--- ti99sim-0.16.0-a/rules.mak	2020-05-25 22:52:22.000000000 +0200
+++ ti99sim-0.16.0-b/rules.mak	2026-05-17 11:30:18.070570725 +0200
@@ -16,19 +16,18 @@
 CXX      := ccache $(CXX)
 endif
 
-CFLAGS   += --std=c++2a
+CFLAGS   += -std=c++20
 CFLAGS   += -fno-strict-aliasing -fexceptions -fPIC
 CFLAGS   += -fdata-sections -ffunction-sections
 CFLAGS   += -funsigned-char
+CFLAGS   += -DTI_DATA_DIR=\"$(DATA_DIR)\"
 
 LFLAGS   += -Wl,--gc-sections
 LFLAGS   += -rdynamic
 
-XLIBS    += -lstdc++fs
-
 WARNINGS := -Wall -Wextra -Wno-unused-parameter -Wno-missing-field-initializers
 WARNINGS += -Wno-implicit-fallthrough
-WARNINGS += -Wno-maybe-uninitialized
+WARNINGS += -Wno-uninitialized
 WARNINGS += -Wcast-qual
 
 INCLUDES := -I../../include
@@ -41,9 +40,6 @@
 DEBUG    := 1
 endif
 
-ifdef ARCH
-CFLAGS   += -march=$(ARCH)
-endif
 
 ifdef LTO
 CFLAGS   += -flto
@@ -52,9 +48,6 @@
 
 ifdef DEBUG
 CFLAGS   += -g3 -O0 -DDEBUG
-else
-CFLAGS   += -g3 -O3 -fomit-frame-pointer
-LFLAGS   += -g3 -O3
 endif
 
 ifdef LOGGER
